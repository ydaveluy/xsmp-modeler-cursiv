<Configuration xmlns="http://www.ecss.nl/smp/2025/Smdl/Configuration" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Name="NonFinite">
  <Component Path="/Root">
    <FieldValue xsi:type="Types:Float64Value" Field="a" Value="INF"/>
    <FieldValue xsi:type="Types:Float32Value" Field="b" Value="NaN"/>
  </Component>
</Configuration>
