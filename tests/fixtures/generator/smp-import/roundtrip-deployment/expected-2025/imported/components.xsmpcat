/**
 * @id _components
 */
catalogue components

/**
 * @id n
 */
namespace n
{
    /**
     * @id n.Mode
     * @uuid 11111111-0000-4000-8000-000000000711
     */
    public enum Mode
    {
        /**
         * @id n.Mode.Off
         */
        Off = 0,
        /**
         * @id n.Mode.On
         */
        On = 1
    }
    /**
     * @id n.M
     * @uuid 11111111-0000-4000-8000-000000000712
     */
    public model M
    {
        /**
         * @id n.M.mode
         */
        field Mode mode
        /**
         * @id n.M.kids
         */
        container M kids
    }
}
/**
 * @id demo
 */
namespace demo
{
    /**
