link DemoLinks for DemoAssembly

/** Root link definitions. */
/
{
    /** Output field routing. */
    field link outValue -> Child.inValue
    /** Event propagation. */
    event link outbound -> Child.inbound
    /** Logger publication. */
    interface link logger -> Child:backLogger
}
