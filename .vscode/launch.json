{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run XSMP Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode",
        "${workspaceFolder}/example"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode/out/**/*.js"
      ],
      "env": {
        "CURSIV_SERVER_DIR": "${command:cmake.buildDirectory}/src"
      },
      "preLaunchTask": "build the server and the extension"
    },
    {
      "name": "Run XSMP + TAS-MDK Extensions (WASI Debug)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode",
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/tas-mdk",
        "${workspaceFolder}/example"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode/out/**/*.js"
      ],
      "env": {
        "CURSIV_SERVER_DIR": "${workspaceFolder}/build-wasi-debug/src"
      },
      "preLaunchTask": "build XSMP and TAS-MDK for WASI Debug"
    }
  ]
}
