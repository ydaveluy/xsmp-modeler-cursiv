# Embeds every builtins/*.xsmpcat resource into a generated C++ source that
# defines xsmp::builtinSources(). Runs at configure time, and again when a
# builtin file is added, removed or edited.
#
# The content is emitted inside a raw string literal with the `XSMPBUILTIN`
# delimiter, which never appears in xsmpcat sources.

set(XSMP_BUILTINS_GENERATED
    "${CMAKE_CURRENT_BINARY_DIR}/generated/Builtins.generated.cpp")

file(GLOB _xsmp_builtin_files CONFIGURE_DEPENDS
     "${PROJECT_SOURCE_DIR}/builtins/*.xsmpcat")
list(SORT _xsmp_builtin_files)
# The glob only sees the list of files; the content is read below.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
             ${_xsmp_builtin_files})

set(_gen "// Generated by cmake/EmbedBuiltins.cmake — do not edit.\n")
string(APPEND _gen "#include <xsmp/Builtins.hpp>\n\n#include <array>\n\n")
string(APPEND _gen "namespace xsmp {\nnamespace {\n\n")

set(_entries "")
set(_idx 0)
foreach(_file ${_xsmp_builtin_files})
  get_filename_component(_basename "${_file}" NAME)
  file(READ "${_file}" _text)
  string(REPLACE "@" "%40" _encoded "${_basename}")
  string(APPEND _gen
         "constexpr std::string_view kBuiltinUri${_idx}{\"xsmp:/${_encoded}\"};\n")
  string(APPEND _gen
         "constexpr std::string_view kBuiltinText${_idx}{R\"XSMPBUILTIN(${_text})XSMPBUILTIN\"};\n\n")
  string(APPEND _entries
         "    BuiltinSource{kBuiltinUri${_idx}, kBuiltinText${_idx}},\n")
  math(EXPR _idx "${_idx} + 1")
endforeach()

string(APPEND _gen
       "constexpr std::array<BuiltinSource, ${_idx}> kSources{{\n${_entries}}};\n\n")
string(APPEND _gen "} // namespace\n\n")
string(APPEND _gen
       "std::span<const BuiltinSource> builtinSources() { return kSources; }\n\n")
string(APPEND _gen "} // namespace xsmp\n")

set(_previous "")
if(EXISTS "${XSMP_BUILTINS_GENERATED}")
  file(READ "${XSMP_BUILTINS_GENERATED}" _previous)
endif()
if(NOT _previous STREQUAL _gen)
  file(WRITE "${XSMP_BUILTINS_GENERATED}" "${_gen}")
endif()
message(STATUS "Embedded ${_idx} xsmpcat builtin(s) into ${XSMP_BUILTINS_GENERATED}")
